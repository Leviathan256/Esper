<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Location: encounters are seeded near the player's real position, and the
        movement radius the avatar acts inside is centred on the GPS fix. Both are
        core-loop mechanics (see docs/GAME_DESIGN.md, Combat > Movement). COARSE is
        declared alongside FINE because Android 12+ lets the user grant approximate
        accuracy only, and the leash circle is designed to absorb that error.
        Nothing derived from a fix ever leaves the device.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Package visibility (API 30+): without these, resolveActivity() cannot see
        Obtainium or a browser, and the update buttons would silently do nothing.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="obtainium" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Esper"
        android:supportsRtl="true"
        android:theme="@style/Theme.Esper">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>

