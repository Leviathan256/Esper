# Copy to /etc/esper/server.env (setup.sh does this). No secrets belong in git.
ESPER_PORT=8080
ESPER_DB_URL=jdbc:postgresql://127.0.0.1/esper
ESPER_DB_USER=esper
ESPER_DB_PASSWORD=change-me
ESPER_RP_ID=leviathan256.github.io
# Comma list: android:apk-key-hash:<base64url SHA-256 of the signing cert>[,...]
ESPER_RP_ORIGINS=
ESPER_CONTENT_DIR=/opt/esper/server/content
JAVA_OPTS=-Xmx512m
